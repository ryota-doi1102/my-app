{
  "name": "react-toy-box",
  "private": true,
  "workspaces": ["frontend", "backend", "shared"],
  "scripts": {
    "claude": "dotenv -e .env -- claude",
    "dev": "concurrently --names \"frontend,backend\" --prefix-colors \"cyan,green\" \"npm run dev --workspace=frontend\" \"npm run dev --workspace=backend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "preview": "npm run preview --workspace=frontend",
    "shared:check": "tsc --noEmit --project shared/tsconfig.json",
    "spellcheck": "cspell lint --no-progress --config .cspell/cspell.json",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
